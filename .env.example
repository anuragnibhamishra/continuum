# --- Local development (no backend) ---
# Set to true to use mock login instead of a real API
VITE_USE_MOCK_AUTH=true

# Mock login credentials (only used when VITE_USE_MOCK_AUTH=true)
VITE_MOCK_LOGIN_EMAIL=demo@continuum.local
VITE_MOCK_LOGIN_PASSWORD=demo123456
VITE_MOCK_LOGIN_NAME=Demo User

# --- Production / real backend ---
# Base URL only — do NOT include /auth/login (paths are appended automatically)
# VITE_USE_MOCK_AUTH=false
# VITE_API_URL=http://localhost:3000/api
